    "h": "3bd1f581972ec77778be3fde785bbb885da73ddfc4ad5da8876820bea99bf050"
  },
  {
    "id": 229,
    "raw_id": 13,
    "category": "an_toan",
    "q": "Những công việc có cắt điện nhưng phải gỡ dây tiếp địa để công tác là:",
    "options": [
      "A. Kiểm tra hệ thống tiếp địa của hệ thống trạm.",
      "B. Củng cố lại tiếp đất của thiết bị hoặc cả hệ thống trạm.",
      "C. Kiểm tra cách điện của các thiết bị.",
      "D. Cả 3 nội dung A, B, C đều đúng."
