  },
  {
    "id": 228,
    "raw_id": 12,
    "category": "an_toan",
    "q": "Theo quy trình an toàn điện, phiếu công tác được quy định như thế nào là đúng:",
    "options": [
      "A. Là giấy giao nhiệm vụ làm việc ở thiết bị điện.",
