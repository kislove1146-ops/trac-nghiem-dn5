[
  {
    "id": 1,
    "raw_id": 1,
    "category": "nghiep_vu",
    "q": "Quy định các cấp điều khiển tần số cấp III (điều tần cấp III) được quy định như thế nào theo Thông tư 06/2025/TT-BCT?",
    "options": [
      "A. Là điều chỉnh bằng tay của nhân viên vận hành để đưa tần số hệ thống điện vận hành ổn định.",
      "B. Là điều chỉnh tự động của hệ thống điều tốc để đưa tần số hệ thống điện vận hành ổn định.",
      "C. Là điều chỉnh bằng sự can thiệp bởi lệnh điều độ để đưa tần số hệ thống điện vận hành ổn định.",
      "D. Là điều chỉnh cắt phụ tải tự động để đưa tần số hệ thống điện vận hành ổn định."
    ],
    "h": "cca2f2737573f2b900cb411d0cce47a1deb4a2dc1c37a3660aae8437992c2e32"
  },
  {
    "id": 2,
    "raw_id": 2,
    "category": "nghiep_vu",
    "q": "Nhà máy tham gia điều tần cấp 2 là:",
    "options": [
      "A. Các nhà máy theo quy định của kỹ sư điều hành hệ thống điện quốc gia.",
      "B. Các nhà máy theo quy định của trung tâm điều độ hệ thống điện quốc gia.",
      "C. Tất cả các nhà máy thủy điện không làm nhiệm vụ điều tần cấp I.",
      "D. Tất cả các nhà máy điện không làm nhiệm vụ điều tần cấp I (trừ trường hợp có quy định riêng)."
    ],
    "h": "eb8410ce84bde24acae55a249d3263953000b5c2f6f15bc1fab277723148a712"
  },
  {
    "id": 3,
    "raw_id": 3,
    "category": "nghiep_vu",
    "q": "Nhân viên vận hành cấp dưới:",
    "options": [
      "A. Đối với những lệnh thao tác gây nguy hại đến người hoặc thiết bị, nhân viên vận hành cấp trên vẫn yêu cầu thực hiện thì nhân viên vận hành cấp dưới không phải chịu về hậu quả xảy ra.",
      "B. Có nhiệm vụ thi hành chính xác, không chậm trễ và không bàn cãi mọi mệnh lệnh chỉ huy điều độ của nhân viên vận hành cấp trên, trừ trường hợp việc thi hành lệnh điều độ có thể nguy hại đến con người, thiết bị, nhân viên vận hành cấp dưới có quyền chưa thực hiện nhưng phải báo cáo với nhân viên vận hành cấp trên.",
      "C. Trường hợp cần thiết có thể trì hoãn việc thực hiện lệnh chỉ huy điều độ của nhân viên vận hành cấp trên và không phải chịu trách nhiệm về hậu quả xảy ra nếu đã xin ý kiến của lãnh đạo có thẩm quyền của đơn vị mình.",
      "D. Cả 3 phương án trên đều sai."
    ],
    "h": "ba9241f0d42849defc2ec17e5e502c45386978d754c3044d10cbe5b220a07772"
  },
  {
    "id": 4,
    "raw_id": 4,
    "category": "nghiep_vu",
    "q": "Tuyệt đối không được phép giao nhận ca trong trường hợp sau:",
    "options": [
      "A. Khi có đầy đủ lý do xác định người nhận ca không đủ tỉnh táo do đã uống rượu bia, sử dụng các chất kích thích bị nghiêm cấm.",
      "B. Khi chưa hoàn thành các công việc sự vụ trong ca.",
      "C. Khi đang có sự cố hoặc đang tiến hành những thao tác phức tạp.",
      "D. Cả 3 phương án trên."
    ],
    "h": "d76415388e08830724597680cb9d94888f20c96a03b32c71502e675624d3a6bf"
  },
  {
    "id": 5,
    "raw_id": 5,
    "category": "nghiep_vu",
    "q": "Trong trường hợp nào sau đây nhân viên vận hành cấp dưới không thực hiện lệnh điều độ của nhân viên vận hành cấp trên:",
    "options": [
      "A. Lệnh điều độ đó làm thay đổi biểu đồ công suất phát, trào lưu công suất của nhà máy, trạm biến áp đã được lập kế hoạch.",
      "B. Lệnh điều độ trái với lệnh chỉ đạo của lãnh đạo trực tiếp nhân viên vận hành đơn vị đó.",
      "C. Lệnh điều độ làm ảnh hưởng đến kết dây cơ bản của nhà máy, trạm biến áp.",
      "D. Lệnh điều độ đó gây nguy hiểm đến tính mạng con người hoặc an toàn của thiết bị."
    ],
    "h": "5f30ce7e4beec70bb52075493ab1762d520359f04535c8586ab4716c9c2e0e19"
  },
  {
    "id": 6,
    "raw_id": 6,
    "category": "nghiep_vu",
    "q": "Nhân viên vận hành thực hiện quyền điều khiển thế nào là đúng quy trình trong trường hợp vận hành bình thường",
    "options": [
      "A. Được sự cho phép của cấp điều độ có quyền kiểm tra trước khi thực hiện quyền điều khiển",
      "B. Thông báo thông tin cần thiết với cấp điều độ cấp trên",
      "C. Báo cáo lại cấp điều độ có quyền kiểm tra sau khi thực hiện xong quyền điều khiển.",
      "D. Được sự cho phép của Lãnh đạo trực tiếp"
    ],
    "h": "de993568ed971d61d611758e165b9ab7269c14094efafbf68c19b4dfe7c41e4e"
  },
  {
    "id": 7,
    "raw_id": 7,
    "category": "nghiep_vu",
    "q": "Nhân viên vận hành thực hiện quyền điều khiển thế nào là không đúng quy trình trong trường hợp vận hành bình thường",
    "options": [
      "A. Xin phép và được sự cho phép trước khi thực hiện quyền điều khiển với cấp điều độ có quyền kiểm tra.",
      "B. Thông báo thông tin cần thiết với đơn vị có quyền nắm thông tin",
      "C. Báo cáo đơn vị có quyền nắm thông tin sau khi thực hiện xong quyền điều khiển.",
      "D. Báo cáo cấp điều độ có quyền kiểm tra sau khi thực hiện xong quyền điều khiển."
